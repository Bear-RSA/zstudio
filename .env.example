# ── Client preview ─────────────────────────────────────────
# DEMO_MODE=1 runs the site on sample data with a preview banner, an open admin and no emails.
# Ignored automatically once Firebase is configured below.
DEMO_MODE=

# ── Firebase ───────────────────────────────────────────────
# Service account JSON (one line). Firebase console → Project settings → Service accounts.
# Leave unset in local dev to use the in-memory store, or set FIRESTORE_EMULATOR_HOST.
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=zstudio-dev

# Client config for the admin login (Firebase console → Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ── Admin dashboard ────────────────────────────────────────
# Staff allowed into /admin (comma-separated). Or grant the claim: npm run admin:grant -- <email>
ADMIN_EMAILS=

# ── Cloudinary ─────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Resend ─────────────────────────────────────────────────
RESEND_API_KEY=
# Verified sender domain in Resend, e.g. "Z Studios <bookings@zstudios.co.za>"
EMAIL_FROM=Z Studios <onboarding@resend.dev>
# Where new enquiries are sent
BOOKINGS_INBOX=bookings@example.com
# Newsletter sign-ups are added as Resend contacts; optionally into this segment (Resend → Audience → Segments)
RESEND_NEWSLETTER_SEGMENT_ID=
# Shown to customers for proof of payment
PROOF_OF_PAYMENT_EMAIL=accounts@example.com

# ── EFT banking details (shown on confirmation page + customer email) ──
BANK_NAME=[BANK NAME]
BANK_ACCOUNT_NAME=[ACCOUNT NAME]
BANK_ACCOUNT_NUMBER=[ACCOUNT NUMBER]
BANK_BRANCH_CODE=[BRANCH CODE]
BANK_ACCOUNT_TYPE=Business Cheque

# Hours an enquiry holds stock before it stops blocking dates
HOLD_HOURS=48
